# Enable Apache proxy_http module for ProxyPass directives
RUN a2enmod proxy_http proxy_wstunnel headers substitute

# Copy Attu Node.js application
COPY --from=attu /app /app

# Fix permissions for attu to write env-config.js
# DDEV runs supervisor as the container user, so attu needs matching ownership
RUN chown -R $username:$username /app/build

# Copy Supervisor config for attu service
COPY supervisor/attu.conf /etc/supervisor/conf.d/attu.conf
